{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clearideas/consent-analytics/server/schemas/data-policy.schema.json",
  "title": "Consent analytics data policy",
  "description": "Maps visitor regions to profiles. A profile decides whether consent is required, what the collector stores with events, and for how long. Rules are checked in order; the first match wins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "regionSets": {
      "description": "Named groups of regions, referenced as \"@name\". Built in: @EU, @EEA.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/region" }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "rules": {
      "description": "Checked in order; the first matching rule selects the profile. Must include a catch-all (\"*\"). The profile for \"unknown\" (region not determined) must require consent.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "region": {
      "description": "A country (ISO 3166-1 alpha-2, e.g. \"DE\"), a subdivision (ISO 3166-2, e.g. \"US-CA\"), or a region set (\"@EU\").",
      "type": "string",
      "pattern": "^(?:[A-Z]{2}|[A-Z]{2}-[A-Z0-9]{1,3}|@[A-Za-z][A-Za-z0-9_-]{0,63})$"
    },
    "match": {
      "anyOf": [
        { "enum": ["unknown", "*"] },
        { "$ref": "#/$defs/region" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "anyOf": [{ "const": "unknown" }, { "$ref": "#/$defs/region" }] }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "profile"],
      "properties": {
        "match": { "$ref": "#/$defs/match" },
        "profile": { "$ref": "#/$defs/name" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent"],
      "properties": {
        "description": { "type": "string" },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": {
              "description": "Whether visitors must opt in before full tracking.",
              "type": "boolean"
            },
            "withoutConsent": {
              "description": "Where consent is required: what browsers may send before it is given. limited (default): anonymous essential events. none: nothing.",
              "enum": ["limited", "none"]
            }
          }
        },
        "collect": {
          "description": "What the collector stores with events, besides what the browser sends. Absent settings mean: not stored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "full": { "$ref": "#/$defs/fullCollection" },
            "limited": { "$ref": "#/$defs/limitedCollection" },
            "onGlobalPrivacyControl": {
              "description": "Overrides for full events when the browser sends Sec-GPC: 1.",
              "$ref": "#/$defs/fullCollection"
            }
          }
        },
        "retention": {
          "description": "How long to keep data, from when it was received. Absent: no expiry.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "events": { "$ref": "#/$defs/duration" },
            "ip": { "$ref": "#/$defs/duration" },
            "rawUserAgent": { "$ref": "#/$defs/duration" },
            "consents": { "$ref": "#/$defs/duration" }
          }
        }
      }
    },
    "fullCollection": {
      "description": "For full events (statistics consent given, or not required).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ip": { "enum": ["none", "truncated", "hashed", "full"] },
        "geo": { "enum": ["none", "country", "region", "city", "coords"] },
        "network": { "enum": ["none", "asn", "org"] },
        "userAgent": { "enum": ["none", "device-type", "parsed", "raw"] },
        "language": { "type": "boolean" },
        "privacyFlags": { "type": "boolean" },
        "gpc": { "type": "boolean" },
        "identity": { "type": "boolean" },
        "clientProps": {
          "description": "Browser-sent props to drop before storing (default: keep all).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "limitedCollection": {
      "description": "For limited events (no statistics consent). Never an IP address or identity (spec).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geo": { "enum": ["none", "country", "region"] },
        "network": { "enum": ["none", "asn"] },
        "userAgent": { "enum": ["none", "device-type", "parsed"] },
        "language": { "type": "boolean" },
        "gpc": { "type": "boolean" }
      }
    },
    "duration": {
      "description": "e.g. 30d, 12w, 25mo, 5y",
      "type": "string",
      "pattern": "^\\d{1,4}(?:d|w|mo|y)$"
    }
  }
}
